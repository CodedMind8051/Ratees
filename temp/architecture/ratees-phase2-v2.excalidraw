      "id": "text_20_7201",
      "type": "text",
      "text": "id            => ObjectId (Mongo _id)\nadminId       => ObjectId (ref: User)\nname          => string\ndescription   => string\npasswordHash  => string   [bcrypt]\nthumbnailUrl  => string (R2 URL)\nisPublic      => boolean\ntotalMembers  => Int  (denorm. counter)\nmaxMemberLimit=> Int\ncreatedAt     => date\nupdatedAt     => date",
